{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Authenticated executive or officer user profile",
      "type": "object",
      "properties": {
        "officerId": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["FOUNDER", "CO_FOUNDER", "CEO", "COO", "HR", "MANAGER", "OFFICER"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "photoUrl": { "type": "string" },
        "faceLockEnabled": { "type": "boolean" },
        "faceLockData": { "type": "string" },
        "faceLockEnrolledAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["officerId", "name", "email", "role", "status"]
    },
    "Employee": {
      "title": "Employee Record",
      "description": "UniGrova corporate staff records",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "preferredName": { "type": "string", "maxLength": 60 },
        "employeeId": { "type": "string", "maxLength": 32 },
        "photoUrl": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "designation": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "joiningDate": { "type": "string" },
        "employmentType": { "type": "string" },
        "workLocation": { "type": "string" },
        "reportingManager": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "emergencyContactRelationship": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended", "Pending"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["fullName", "employeeId", "department", "designation", "status"]
    },
    "IDCard": {
      "title": "ID Card Record",
      "description": "Issued employee identity credentials",
      "type": "object",
      "properties": {
        "idCardId": { "type": "string", "maxLength": 64 },
        "employeeId": { "type": "string", "maxLength": 32 },
        "employeeName": { "type": "string", "maxLength": 100 },
        "designation": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "issuedAt": { "type": "string" },
        "issuedBy": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Active", "Revoked", "Expired"] },
        "qrVerificationId": { "type": "string", "maxLength": 64 },
        "cardVersion": { "type": "string" },
        "ceoSignatureUrl": { "type": "string" }
      },
      "required": ["idCardId", "employeeId", "employeeName", "issuedAt", "qrVerificationId", "status"]
    },
    "Department": {
      "title": "Department",
      "description": "Organizational department unit",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 100 },
        "head": { "type": "string", "maxLength": 100 },
        "employeeCount": { "type": "number" },
        "budget": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["code", "name"]
    },
    "Project": {
      "title": "Project",
      "description": "UniGrova technology or venture project",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string" },
        "department": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "lead": { "type": "string" },
        "budget": { "type": "string" },
        "targetDate": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Audit trail of management operations",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorName": { "type": "string", "maxLength": 100 },
        "actorRole": { "type": "string" },
        "action": { "type": "string", "maxLength": 500 },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["actorName", "action", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notices and task assignments",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string" },
        "recipientOfficerId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message", "createdAt"]
    },
    "CompanySettings": {
      "title": "Company Settings",
      "description": "UniGrova global corporate settings",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "website": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "ceoName": { "type": "string" },
        "ceoSignatureUrl": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["companyName", "ceoName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records indexed by auth UID or officerId"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "UniGrova employee documents"
    },
    "/idCards/{idCardId}": {
      "schema": "IDCard",
      "description": "Official company ID cards and verification tokens"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Organizational departments"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Company engineering and technology initiatives"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Immutable executive activity logs"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Internal executive alerts and action items"
    },
    "/settings/{settingId}": {
      "schema": "CompanySettings",
      "description": "UniGrova organizational settings including CEO signature"
    }
  }
}
